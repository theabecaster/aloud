/* Agent Speak — the spoken consent prompt. This is the string that
   tells someone a decision is being asked of them, so it must never
   fall back to English. */
"Let %@ agent listen? Yes or no" = "¿Dejar escuchar al agente %@? Sí o no";

/* Agent Speak — Settings → Agent Speak: whether an agent is asked
   before it listens, how the asking happens, and the agent tools Aloud
   can set itself up in. The on/off switch is not here — it lives in
   General → Experimental with the other experiments. */
"Permission" = "Permiso";
"Ask before listening" = "Preguntar antes de escuchar";
