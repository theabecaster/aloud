"Review" = "Revisar";
"Corrections Aloud saw you make. Accept one and it joins the list below; decline and it won’t be suggested again." = "Correcciones que Aloud te vio hacer. Al aceptar una, pasa a la lista de abajo; si la rechazas, no volverá a sugerirse.";
"Suggested: type “%1$@” instead of “%2$@”" = "Sugerencia: escribir «%1$@» en lugar de «%2$@»";
"Review %ld suggested fixes" = "Revisar %ld correcciones sugeridas";
"Suggested Fixes" = "Correcciones sugeridas";
"Aloud noticed these corrections. Accepting one fixes that word automatically from now on." = "Aloud detectó estas correcciones. Al aceptar una, esa palabra se corregirá automáticamente a partir de ahora.";
"Accept All" = "Aceptar todas";
"Deny All" = "Rechazar todas";
"Fix it automatically next time" = "Corregirlo automáticamente la próxima vez";
"Never suggest this fix" = "No volver a sugerir esta corrección";
"Suggest fixes from your edits" = "Sugerir correcciones a partir de tus cambios";
"Aloud notices when you correct a dictation where it landed and offers to fix it automatically next time. Nothing leaves this Mac." = "Aloud nota cuando corriges un dictado donde quedó escrito y ofrece corregirlo automáticamente la próxima vez. Nada sale de este Mac.";
"Learned from your edits" = "Aprendida de tus cambios";
"Aloud noticed a fix — review it in the menu bar" = "Aloud detectó una corrección — revísala en la barra de menús";

/* Agent voice — the spoken consent prompt. This is the string that
   tells someone a decision is being asked of them, so it must never
   fall back to English. */
"An agent wants to listen — say accept or decline" = "Un agente quiere escuchar: di aceptar o rechazar";
"%@ wants to listen — say accept or decline" = "%@ quiere escuchar: di aceptar o rechazar";
